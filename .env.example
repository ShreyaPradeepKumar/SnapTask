# SnapTask local configuration.
# Copy this file to .env and fill in your value. The .env file is private
# (git-ignored); .env.example is shared as a template.

# Your Google OAuth Client ID for a Chrome extension.
# Created in Google Cloud: APIs & Services -> Credentials ->
#   OAuth client ID -> Chrome Extension -> your extension's ID.
# It looks like: 123456789012-abc....apps.googleusercontent.com
SNAPTASK_GOOGLE_CLIENT_ID=